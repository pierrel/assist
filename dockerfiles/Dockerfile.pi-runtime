FROM node:22.23.1-bookworm-slim

RUN apt-get update && apt-get install --yes --no-install-recommends python3 && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY assist/pi_runtime/package.json assist/pi_runtime/package-lock.json ./
RUN npm ci --ignore-scripts
COPY assist/pi_runtime/tsconfig.json ./
COPY assist/pi_runtime/src ./src
RUN npm run build && npm prune --omit=dev
COPY assist/pi_runtime/provider_adapter.py /usr/local/bin/pi-provider-adapter

USER node
ENTRYPOINT ["python3", "/usr/local/bin/pi-provider-adapter"]
CMD ["node", "/app/dist/worker.js"]
